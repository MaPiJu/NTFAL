# Local settings and SECRETS. Copy to .env (never committed: see .gitignore).
# The scanner needs none of this; only bot.py's testnet/mainnet modes and the
# Telegram report do.

# Override account equity from config.toml
#EQUITY=10000

# Override risk per trade (fraction; hard-capped at 0.02 regardless)
#RISK_PCT=0.01

# Override the Hyperliquid public info endpoint (the scanner's reads)
#HL_API_URL=https://api.hyperliquid.xyz/info

# The account's PUBLIC address (0x…): read for open positions, orders and fills,
# and the account bot.py trades for. Overrides [positions].address in config.toml.
#HL_ADDRESS=0x0000000000000000000000000000000000000000

# --- bot.py, [execution] mode "testnet" or "mainnet" only --------------------
# The private key of an API WALLET (app.hyperliquid.xyz -> More -> API): it can
# place and cancel orders for HL_ADDRESS but CANNOT withdraw. Never put your
# main wallet's key here: bot.py refuses it. Keep this file chmod 600.
#HL_API_PRIVATE_KEY=0x...

# --- Telegram ([telegram] enabled = true) -------------------------------------
# Create a bot with @BotFather (gives the token), send it a message, then read
# your chat id from https://api.telegram.org/bot<TOKEN>/getUpdates.
#TELEGRAM_BOT_TOKEN=123456789:AA...
#TELEGRAM_CHAT_ID=123456789
