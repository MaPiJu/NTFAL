# systemd unit for bot.py on a VPS — see docs/DEPLOIEMENT.md.
#
# One service does it all: every horizon refreshed right after its entry bar
# closes, the dashboard on 127.0.0.1:8000 (reach it through an SSH tunnel), the
# daily Telegram report and — only when config.toml sets [execution] enabled =
# true — the trade cycle and the stop checks.
#
# deploy/install.sh installs it (as root, from the clone, e.g. /opt/ntfal): the
# code stays root's, read-only to the service; the "ntfal" user owns only cache/
# and .env. By hand (cache/ must exist and belong to ntfal, or the unit fails):
#   install -d -o ntfal -g ntfal -m 750 /opt/ntfal/cache
#   cp deploy/ntfal-bot.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now ntfal-bot
#   journalctl -u ntfal-bot -f          # follow the log
#
# Stopping the service leaves the protective stops resting on the exchange.

[Unit]
Description=NTFAL — Elder Triple Screen bot (Hyperliquid)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ntfal
Group=ntfal
WorkingDirectory=/opt/ntfal
# .env holds the API wallet key and the Telegram token: chmod 600, owned by ntfal.
# python-dotenv reads it from the working directory; nothing else is needed here.
ExecStart=/opt/ntfal/.venv/bin/python bot.py --serve --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=30
# Unbuffered output, so journalctl shows each line as it happens.
Environment=PYTHONUNBUFFERED=1
# The code is read-only to the service (below): no __pycache__ to write.
Environment=PYTHONDONTWRITEBYTECODE=1

# Hardening: the bot only needs to write its cache directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ntfal/cache

[Install]
WantedBy=multi-user.target
